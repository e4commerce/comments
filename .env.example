# =============================================================================
# Pulse — variáveis de ambiente
#
# Validado no boot por packages/shared/src/env.ts. Variável obrigatória ausente
# derruba o processo com mensagem explícita (§3.4 do PRD).
#
# Copie para .env e preencha. Nunca comite .env.
# =============================================================================

# --- Banco de dados ----------------------------------------------------------
# Dois roles por decisão de segurança. Ver infra/postgres/init/01-roles.sql.
#
# ATENÇÃO: os valores abaixo ficam VAZIOS de propósito. O Railway oferece as
# "Suggested Variables" a partir deste arquivo, e um localhost aqui viraria
# localhost dentro do container — onde não existe banco nenhum. Falha como
# "healthcheck de banco falhou", que não sugere a causa.
#
# Local (Docker):
#   DATABASE_URL=postgresql://pulse_app:pulse_app_password@localhost:5432/pulse
#   DATABASE_URL_MIGRATOR=postgresql://pulse_owner:pulse_dev_password@localhost:5432/pulse
# Railway (rede privada; troque `Postgres` pelo nome real do seu serviço):
#   DATABASE_URL=postgresql://pulse_app:SENHA@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/railway
#
# DATABASE_URL é o role de runtime: sem BYPASSRLS, não dono das tabelas.
DATABASE_URL=
# DATABASE_URL_MIGRATOR é o dono das tabelas, com privilégio de DDL. Usado só por
# `pnpm db:migrate`, da máquina de quem migra. NUNCA defina nos serviços de deploy.
DATABASE_URL_MIGRATOR=

# --- Redis -------------------------------------------------------------------
# Local: redis://localhost:6379
# Railway: ${{Redis.REDIS_URL}}
REDIS_URL=

# --- Aplicação ---------------------------------------------------------------
# URL pública base. Usada no callback do OAuth do Meta e no header HTTP-Referer
# enviado ao OpenRouter (§9.1) — por isso não existe variável separada para ele.
# Local: http://localhost:3000 — Railway: https://SEU-DOMINIO (https é exigido
# quando NODE_ENV=production).
APP_URL=
# openssl rand -base64 32
AUTH_SECRET=
LOG_LEVEL=info
# development | test | production
NODE_ENV=development

# --- Login com Google (opcional; §3.1 exige e-mail/senha E Google) -----------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- E-mail (Resend) ---------------------------------------------------------
# Obrigatório: convites de usuário são entregável da Fase 1 (§16), e alertas de
# needs_reauth (§5.2), SLA (§7.7) e anomalia (§8.3) dependem de envio.
RESEND_API_KEY=
EMAIL_FROM="Pulse <nao-responda@exemplo.com.br>"

# --- Meta / Graph API --------------------------------------------------------
# Um único app cobre Facebook, Instagram e Ads. Use apps distintos para dev e
# produção: modo Live, Business Verification e callback de webhook são por app.
META_APP_ID=
META_APP_SECRET=
# String arbitrária que você repete no App Dashboard ao configurar o webhook.
META_WEBHOOK_VERIFY_TOKEN=
# v26.0 e não v23.0 do §3.4: a referência [5] do próprio PRD cita v26.0, e v23.0
# está próximo do sunset de 2 anos. Ver Seção 1 do plano de execução.
META_GRAPH_VERSION=v26.0
META_API_TIMEOUT_MS=15000

# --- Criptografia de tokens --------------------------------------------------
# AES-256-GCM, 32 bytes em base64: openssl rand -base64 32
# O ciphertext é gravado com prefixo de versão (v1:...) para permitir rotação de
# chave sem downtime.
ENCRYPTION_KEY=

# --- OpenRouter --------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=google/gemini-2.5-flash
OPENROUTER_MODEL_FALLBACK=openai/gpt-4.1-mini
OPENROUTER_MODEL_REASONING=anthropic/claude-sonnet-4.5
# ATENÇÃO: o endpoint de embeddings do OpenRouter não expõe parâmetro `dimensions`,
# e ai_topics.centroid / comment_embeddings.embedding são vector(1536) fixos (§6.6).
# Só troque por um modelo de 1536 dimensões nativas, ou a migration falha no boot.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
OPENROUTER_APP_TITLE=Pulse
# Teto mensal de gasto de IA. Default de novas organizações e teto absoluto da
# plataforma; organizations.ai_budget_usd prevalece quando definido.
AI_MONTHLY_BUDGET_USD=200

# --- Ingestão (§5.8) ---------------------------------------------------------
# Janela do backfill inicial ao conectar uma página.
BACKFILL_DAYS=90
# Páginas de cursor por execução de reconciliação, antes de salvar o cursor e sair.
RECONCILE_MAX_PAGES_PER_RUN=20

# --- Privacidade (§11.4) -----------------------------------------------------
# Default de novas organizações; o valor efetivo vive em organizations.settings.
RETENTION_MONTHS_DEFAULT=24

# --- Observabilidade ---------------------------------------------------------
SENTRY_DSN=
