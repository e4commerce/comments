# =============================================================================
# Meta Comments — variáveis de ambiente
#
# Copie para .env e preencha. Validado no boot por src/lib/env.ts: variável
# obrigatória ausente derruba o processo com mensagem explícita.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# URL pública base. Usada no redirect do OAuth do Meta (precisa bater EXATAMENTE
# com o "Valid OAuth Redirect URI" no App Dashboard) e no header HTTP-Referer
# do OpenRouter. Local: http://localhost:3000
APP_URL=http://localhost:3000

# Senha única de acesso à plataforma. Operador único — não há cadastro de users.
# Gere algo longo: openssl rand -base64 24
APP_PASSWORD=

# Assina o cookie de sessão: openssl rand -base64 32
AUTH_SECRET=

# Cifra os tokens do Meta em repouso (AES-256-GCM, 32 bytes em base64):
# openssl rand -base64 32
ENCRYPTION_KEY=

# --- Banco de dados ----------------------------------------------------------
# SQLite, arquivo local. Sem servidor, sem docker. O diretório é criado no boot.
DATABASE_PATH=./data/comments.db

# --- Meta / Graph API --------------------------------------------------------
# Um app cobre Facebook e Instagram. Crie em developers.facebook.com, tipo
# "Business", e adicione o produto "Facebook Login".
#
# Permissões necessárias (Advanced Access exige App Review + Business
# Verification para uso em páginas que não são suas):
#   pages_show_list, pages_read_engagement, pages_manage_engagement,
#   pages_read_user_content, instagram_basic, instagram_manage_comments,
#   business_management
#
# Enquanto o app estiver em modo Development, funciona normalmente para as
# páginas das quais VOCÊ é admin — suficiente para uso próprio.
META_APP_ID=
META_APP_SECRET=

# Versão da Graph API. Cada versão vive ~2 anos; se a API responder
# "Unsupported get request" em tudo, suba a versão aqui.
META_GRAPH_VERSION=v23.0
META_API_TIMEOUT_MS=15000

# --- OpenRouter (análise de IA) ----------------------------------------------
# openrouter.ai/keys. Sem ela a plataforma funciona, mas sem sentimento,
# motivos nem resumo — a aba de análise avisa em vez de mostrar zeros.
OPENROUTER_API_KEY=
# Modelo barato e rápido: a análise roda sobre todo o corpus de comentários.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Aparece no seu dashboard do OpenRouter, via header X-Title.
OPENROUTER_APP_TITLE=Meta Comments
# Comentários por chamada de IA. Maior = mais barato e mais rápido, mas
# aumenta a chance de o modelo truncar a resposta.
AI_BATCH_SIZE=25

# --- Sincronização -----------------------------------------------------------
# Janela do backfill ao conectar uma conta, e de cada sync manual.
BACKFILL_DAYS=90
